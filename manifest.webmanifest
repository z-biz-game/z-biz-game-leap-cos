{
  "name": "跳蛙渡 Leap",
  "short_name": "跳蛙渡",
  "description": "两岸的蛙互换位置。每关的最短步数由该河段全部可达位置的广度优先搜索量出，再由闭式 n(n+2) 与带记忆的深度优先搜索各自复现一遍。",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#08121a",
  "theme_color": "#101418",
  "lang": "zh-CN",
  "dir": "ltr",
  "categories": ["games", "puzzle"],
